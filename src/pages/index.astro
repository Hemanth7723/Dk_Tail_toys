---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const database = getDatabase();
const games = await getAllGames(database);
const categories = await getAllCategories(database);
const publishers = await getAllPublishers(database);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-6 mb-8">
        <div>
          <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
          <p class="mt-2 text-slate-400">Filter the catalog by category or publisher.</p>
        </div>

        <form action="/" method="get" class="rounded-xl border border-slate-700 bg-slate-800/60 p-5" data-testid="game-filters">
          <fieldset>
            <legend class="text-lg font-medium text-slate-100">Categories</legend>
            <div class="mt-3 flex flex-wrap gap-3">
              {categories.map((category) => (
                <label class="flex items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500">
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    class="h-4 w-4 accent-blue-500"
                    data-testid={`category-filter-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-end">
            <div class="flex flex-col gap-2">
              <label for="publisher-filter" class="text-sm font-medium text-slate-200">Publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </div>
            <button
              type="submit"
              class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="apply-filters"
            >
              Apply filters
            </button>
            <a
              href="/"
              class="rounded-lg border border-slate-600 px-4 py-2 text-center font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="clear-filters"
            >
              Clear filters
            </a>
          </div>
        </form>

        <p class="text-sm text-slate-400" aria-live="polite" data-testid="filter-results">
          Showing {games.length} of {games.length} games
        </p>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div class="hidden" data-testid="filtered-empty">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const resultSummary = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');

  if (filterForm && resultSummary && emptyState && gamesGrid) {
    const params = new URLSearchParams(window.location.search);
    const categoryInputs = Array.from(
      filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]'),
    );
    const publisherInput = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const availableCategoryIds = new Set(categoryInputs.map((input) => input.value));
    const selectedCategories = new Set(
      params.getAll('category').filter((categoryId) => availableCategoryIds.has(categoryId)),
    );
    const selectedPublisher =
      publisherInput && Array.from(publisherInput.options).some((option) => option.value === params.get('publisher'))
        ? params.get('publisher') ?? ''
        : '';

    categoryInputs.forEach((input) => {
      input.checked = selectedCategories.has(input.value);
    });
    if (publisherInput) {
      publisherInput.value = selectedPublisher;
    }

    let visibleCount = 0;
    gameCards.forEach((card) => {
      const categoryMatches =
        selectedCategories.size === 0 ||
        selectedCategories.has(card.dataset.gameCategoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || card.dataset.gamePublisherId === selectedPublisher;
      const isVisible = categoryMatches && publisherMatches;

      card.hidden = !isVisible;
      if (isVisible) {
        visibleCount += 1;
      }
    });

    resultSummary.textContent = `Showing ${visibleCount} of ${gameCards.length} games`;
    emptyState.classList.toggle('hidden', visibleCount !== 0);
    gamesGrid.classList.toggle('hidden', visibleCount === 0);
  }
</script>
